{
  "name": "@deepseek-harness-pocket/gateway",
  "version": "0.1.0",
  "description": "deepseek-harness-pocket Gateway：手机↔Worker 中转（Next.js 管理面 + 自定义 server 承载 WebSocket）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "build": "next build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-harness-pocket/bridge-protocol": "workspace:*",
    "@deepseek-harness-pocket/legal": "workspace:*",
    "jose": "^6.2.9",
    "next": "^16.2.0",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
