{
  "name": "@deepseek-harness-pocket/bridge",
  "version": "0.1.0",
  "description": "deepseek-harness-pocket 电脑端：DeepSeek Harness 桥接插件（mobile/v1 协议服务端）+ dshc Worker CLI",
  "type": "module",
  "license": "MIT",
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./cli": "./dist/cli/index.js"
  },
  "bin": {
    "dshc": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/plugin/index.ts --bundle --platform=node --format=esm --external:@deepseek-ai/* --external:ws --outfile=dist/plugin/index.js && esbuild src/cli/index.ts --bundle --platform=node --format=esm --external:@deepseek-ai/* --external:ws --external:qrcode-terminal --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^22",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.10",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "@deepseek-harness-pocket/bridge-protocol": "workspace:*",
    "esbuild": "^0.24.0"
  }
}
