# gateway 环境变量（复制为 .env 并填写）
# PostgreSQL（gateway 自有库，与 zhongbei_auth 隔离）
DATABASE_URL=postgresql://dsh_gateway:change-me@localhost:5432/dsh_gateway

# 监听
PORT=3781
HOSTNAME=0.0.0.0

# 掌鲸 DSH Pocket 认证：JWKS 公钥端点（auth 侧 GET /api/v1/auth/jwks）
# gateway 本地验签 RS256 JWT，不依赖 auth 在线。
# AUTH_ISSUER/AUTH_AUDIENCE 必须与 auth 签发时一致（默认值已匹配）。
AUTH_JWKS_URL=
AUTH_ISSUER=https://auth.zhongbei.tech
AUTH_AUDIENCE=dsh-pocket

# Expo Push（iOS APNs；空则通知仅投递在线手机）
EXPO_ACCESS_TOKEN=
