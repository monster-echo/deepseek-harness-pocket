{
  "expo": {
    "name": "掌鲸 DSH Pocket",
    "slug": "dshcompanion",
    "scheme": [
      "dshcompanion",
      "mobileui"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "icon": "./assets/app-icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 88,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/withModularHeaders",
      "expo-video",
      [
        "expo-image-picker",
        {
          "cameraPermission": "允许拍照并发送给电脑上的 dsh 会话。"
        }
      ]
    ],
    "ios": {
      "usesAppleSignIn": true,
      "bundleIdentifier": "top.rwecho.dshcompanion",
      "associatedDomains": [
        "applinks:auth.zhongbei.tech"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "掌鲸需要访问本地网络，以便发现并连接你电脑上运行的 DSH 助手。",
        "NSMicrophoneUsageDescription": "允许掌鲸使用麦克风，以便录制语音消息并发送到会话。",
        "NSPhotoLibraryUsageDescription": "当你选择照片作为头像或上传反馈截图时，掌鲸需要访问你的相册。"
      }
    },
    "android": {
      "package": "top.rwecho.dshcompanion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#B03C3C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "auth.zhongbei.tech"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "cad81535-4374-4c46-88c1-2697e73e7127"
      }
    },
    "owner": "rwecho007"
  }
}
